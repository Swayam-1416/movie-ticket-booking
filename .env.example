SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Copy this file to .env and fill in the MySQL user/password below.
# For a quick SQLite preview, change DB_ENGINE to sqlite3.
DB_ENGINE=mysql
DB_NAME=movie_tickets
DB_USER=movie_app
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
