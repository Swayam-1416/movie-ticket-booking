SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DB_ENGINE=sqlite3 for a quick local start, or set DB_ENGINE=mysql
# and configure the MySQL database below.
DB_ENGINE=sqlite3
DB_NAME=movie_tickets
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
